# Copy to .env and adjust. Never commit .env.
# --- Database ---
POSTGRES_DB=optier
POSTGRES_USER=optier_owner
POSTGRES_PASSWORD=change-me-owner
# Restricted role used by the running app (no UPDATE/DELETE on audit_log)
APP_DB_USER=optier_app
APP_DB_PASSWORD=change-me-app
# --- Server ---
PORT=3000
NODE_ENV=development
# Used by the app at runtime (restricted role)
DATABASE_URL=postgres://optier_app:change-me-app@localhost:5432/optier
# Used by migrations only (owner role)
MIGRATION_DATABASE_URL=postgres://optier_owner:change-me-owner@localhost:5432/optier
UPLOAD_DIR=./uploads
# --- Web / proxy ---
# ":80" for plain LAN testing. Use a real hostname later for automatic HTTPS.
SITE_ADDRESS=:80
